{
  "name": "imgpost",
  "version": "0.3.1",
  "description": "图邮：让 DSH 助手把图片直接发到聊天里给你看，也支持生图和识图。",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "assets",
    "screenshots.json",
    "scripts",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node scripts/regression-test.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "image",
    "image-generation",
    "image-recognition",
    "vision",
    "ocr",
    "chat"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hige6/imgpost.git"
  },
  "bugs": {
    "url": "https://github.com/hige6/imgpost/issues"
  },
  "homepage": "https://github.com/hige6/imgpost#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
